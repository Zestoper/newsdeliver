# Neon PostgreSQL 연결 문자열 (Neon 콘솔 > Connection Details > Connection string)
DB_URL=postgresql+psycopg2://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 네이버 뉴스 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이메일 (SMTP)
SMTP_HOST=smtp.naver.com
SMTP_PORT=587
SMTP_USER=your_naver_id@naver.com
SMTP_PASSWORD=

# 소셜 로그인 - 카카오
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://your-render-app.onrender.com/oauth/kakao/callback

# 소셜 로그인 - 네이버
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=https://your-render-app.onrender.com/oauth/naver/callback

# 소셜 로그인 - 구글
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-render-app.onrender.com/oauth/google/callback

# 서버 기본 URL (Render 배포 URL로 변경)
SERVER_BASE_URL=https://your-render-app.onrender.com

# AI 요약
GROQ_API_KEY=

# 해외뉴스 API
NEWSAPI_KEY=

# 결제 테스트 모드 (true = 결제 스킵)
SKIP_PAYMENT=false
